# Cloudflare API MCP Server の検証に、事前登録したOAuthクライアントは要らない。
# Authorization Server が Dynamic Client Registration (RFC 7591) を開けているので、
# ./run probe が登録して data/client.json に保存する。
#
# 使うのは以下だけ。すべて任意。

# コールバックを受けるローカルポート（redirect_uri は http://localhost:<PORT>/callback）
PORT=8976

# 検証対象。別のMCPサーバーで試すならここを変える
MCP_SERVER_URL=https://mcp.cloudflare.com/mcp

# ネゴシエートするMCPプロトコルバージョン
MCP_PROTOCOL_VERSION=2026-07-28
