  "experiment4_benchmark": {
    "description": "app.fetch() で GET /users/:id を 100,000 回。ウォームアップ 20,000 回。5 ラウンド交互実行。",
    "iterations": 100000,
    "warmup": 20000,
    "rounds": 10,
    "v4": {
      "runsMs": [
        272.7,
        262.13,
        269.22,
        258.31,
        267.46,
        284.91,
        271.84,
        360.6,
        271.85,
        263.35
      ],
      "medianMs": 270.53,
      "meanMs": 278.24,
      "minMs": 258.31,
      "maxMs": 360.6,
      "medianRps": 369645
    },
    "v5": {
      "runsMs": [
        268.3,
        259.35,
        255.59,
        263.16,
        255.8,
        269.94,
        282.37,
        315.01,
        284.31,
        264.7
      ],
      "medianMs": 266.5,
      "meanMs": 271.85,
      "minMs": 255.59,
      "maxMs": 315.01,
      "medianRps": 375235
    },
    "deltaMedianPercent": 1.49,
    "verdict": "v5 が中央値で 1.5%、平均で 2.3%、最小値で 1.1% 速い。ただし両者の分布は大きく重なっており(v4 最小 258.31ms < v5 中央値 266.50ms)、この測り方では有意差とは言えない。コアのルーティング性能は実質同等。",
    "deltaMeanPercent": 2.29,
    "deltaMinPercent": 1.05
  },
  "experiment5_routerFallbackPerf": {
    "description": "v5 で /x*/y と /x/* を同時登録し SmartRouter が TrieRouter にフォールバックした場合の性能差。GET /users/:id を 50,000 回、3 ラウンド。",
    "iterations": 50000,
    "rounds": 12,
    "regExpRouter": {
      "runsMs": [
        141.1,
        287.62,
        138.12,
        139.55,
        149.7,
