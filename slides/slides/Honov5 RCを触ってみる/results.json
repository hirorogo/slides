      "router": "SmartRouter + RegExpRouter",
      "medianMs": 138.68,
      "meanMs": 152.28,
      "minMs": 132.35,
      "maxMs": 287.62,
      "medianRps": 360542
    },
    "trieFallback": {
      "runsMs": [
