# Google Cloud Console の OAuth 2.0 クライアント（ウェブアプリケーション）
#   承認済みの JavaScript 生成元: http://localhost:3000
#   承認済みのリダイレクト URI:   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# 任意。Refresh Token さえ取れればよいので、API 有効化の要らない最小スコープにしてある
GOOGLE_SCOPE=openid email
